<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mengapa iPhone - Paparan Motivasi</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"SF Pro Text"', 'Inter', 'sans-serif'],
          },
          colors: {
            apple: {
              bg: '#000000',
              card: 'rgba(255, 255, 255, 0.05)',
              border: 'rgba(255, 255, 255, 0.1)',
              blue: '#2997ff',
              purple: '#af52de',
              glow: 'rgba(41, 151, 255, 0.15)'
            }
          }
        }
      }
    }
  </script>

  <!-- Google Fonts & Font Awesome -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    /* Custom Scrollbar & Glossy Effects */
    body {
      background-color: #000000;
      color: #f5f5f7;
      overflow-x: hidden;
    }
    
    .glass-card {
      background: rgba(22, 22, 26, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    }
    
    .glass-card:hover {
      border-color: rgba(41, 151, 255, 0.3);
      box-shadow: 0 20px 50px rgba(41, 151, 255, 0.12);
    }

    .apple-gradient-text {
      background: linear-gradient(135deg, #ffffff 0%, #a1a1a6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .accent-gradient-text {
      background: linear-gradient(135deg, #2997ff 0%, #9852f0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Active Tab Glow */
    .tab-active {
      background: rgba(255, 255, 255, 0.15) !important;
      color: #ffffff !important;
      border-color: rgba(255, 255, 255, 0.2) !important;
    }

    /* Notification Toast */
    #toast {
      transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s ease;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-blue-500 selection:text-white">

  <!-- Background Ambient Glow -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-blue-600/15 blur-[140px] pointer-events-none rounded-full"></div>
  <div class="fixed bottom-0 right-0 w-[400px] h-[400px] bg-purple-600/10 blur-[160px] pointer-events-none rounded-full"></div>

  <!-- Header / Navbar -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-black/60 border-b border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <i class="fa-brands fa-apple text-2xl text-white"></i>
        <span class="font-semibold text-lg tracking-tight text-white">Mengapa iPhone</span>
        <span class="hidden sm:inline-block text-xs px-2.5 py-0.5 rounded-full bg-white/10 text-gray-300 font-medium">Esai Motivasi</span>
      </div>

      <!-- Navigation / Controls -->
      <div class="flex items-center space-x-2 bg-white/5 p-1 rounded-full border border-white/10">
        <button id="btnViewEssay" onclick="switchView('essay')" class="tab-active px-4 py-1.5 rounded-full text-xs font-semibold text-gray-400 transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-file-text"></i>
          <span>Mode Esai</span>
        </button>
        <button id="btnViewSlides" onclick="switchView('slides')" class="px-4 py-1.5 rounded-full text-xs font-semibold text-gray-400 hover:text-white transition-all duration-200 flex items-center gap-2">
          <i class="fa-solid fa-layer-group"></i>
          <span>Mode Slide</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-12 pb-20 flex-grow w-full">

    <!-- HERO SECTION -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-medium mb-4">
        <i class="fa-solid fa-sparkles text-xs"></i> Paparan Motivasi Kelas 7
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight apple-gradient-text mb-4">
        Mengapa iPhone
      </h1>
      <p class="text-gray-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Analisis kritis dan realistis penggunaan iPhone sebagai sarana pendorong produktivitas belajar dan kegiatan sehari-hari.
      </p>
    </div>

    <!-- VIEW 1: ESSAY MODE (SINGLE PAGE) -->
    <div id="essayView" class="space-y-6">

      <!-- PARAGRAF 1 CARD -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 transition-all duration-300 relative group">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 font-bold text-sm">
              01
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">Mengapa Saya Pilih iPhone</h2>
          </div>
          <div class="flex items-center gap-2 opacity-90 sm:opacity-0 group-hover:opacity-100 transition-opacity">
            <button onclick="speakText('text-p1', this)" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white transition" title="Dengarkan Suara">
              <i class="fa-solid fa-volume-high text-xs"></i>
            </button>
            <button onclick="copyCardText('text-p1')" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white transition" title="Salin Paragraf">
              <i class="fa-regular fa-copy text-xs"></i>
            </button>
          </div>
        </div>
        <p id="text-p1" class="text-gray-300 text-base sm:text-lg leading-relaxed font-normal">
          mengapa aku pilih iphone karna iphone memudahkan aku dalam belajar, karna ipad dan iphone lebih mudah buat meyalurkan data dari device 1 ke device 2, iphone itu bukan hanya sekedar buat gaya gayaan tetapi iphone itu buat kegiatan sehari hari lebih enak dibandingkan android karna ios iphone itu lebih mulus dari pada android, daniphone merupakan investasi dalam janga yang cukup panjang untuk mendukung produktivitas
        </p>
      </div>

      <!-- PARAGRAF 2 CARD -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 transition-all duration-300 relative group">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold text-sm">
              02
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">Kelebihan iPhone Dibandingkan Android</h2>
          </div>
          <div class="flex items-center gap-2 opacity-90 sm:opacity-0 group-hover:opacity-100 transition-opacity">
            <button onclick="speakText('text-p2', this)" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white transition" title="Dengarkan Suara">
              <i class="fa-solid fa-volume-high text-xs"></i>
            </button>
            <button onclick="copyCardText('text-p2')" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white transition" title="Salin Paragraf">
              <i class="fa-regular fa-copy text-xs"></i>
            </button>
          </div>
        </div>
        <p id="text-p2" class="text-gray-300 text-base sm:text-lg leading-relaxed font-normal">
          kelebihan iphone dibandingkan android sebenernya banyak tapi kelebihan utama nya terletak pada ios nya iphone Sistem operasinya mengelola memori secara cerdas sehingga performa tetap kencang meski dipakai bertahun-tahun. Fitur ekosistem seperti airDrop membuat proses berbagi tugas dan file menjadi instan, Ditambah jaminan pembaruan iOS jangka panjang dan keamanan privasi yang ketat, iphone menawarkan kenyamanan harian yang lebih konsisten dibanding Android
        </p>
      </div>

      <!-- PARAGRAF 3 CARD -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 transition-all duration-300 relative group">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold text-sm">
              03
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">Hal Yang Dioptimalkan Saat Menggunakan iPhone</h2>
          </div>
          <div class="flex items-center gap-2 opacity-90 sm:opacity-0 group-hover:opacity-100 transition-opacity">
            <button onclick="speakText('text-p3', this)" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white transition" title="Dengarkan Suara">
              <i class="fa-solid fa-volume-high text-xs"></i>
            </button>
            <button onclick="copyCardText('text-p3')" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white transition" title="Salin Paragraf">
              <i class="fa-regular fa-copy text-xs"></i>
            </button>
          </div>
        </div>
        <p id="text-p3" class="text-gray-300 text-base sm:text-lg leading-relaxed font-normal">
          hal yang dioptimalkan saat menggunakan iphone ajku akan mengoptimalkan mode fokus untuk menjaga konsentrasi saat belajar agar tidak ada notif yang masuk. Dan aku juga akan mengoptimalkan kualitas kamera nya yang sangat jernih dan smooth untuk membuat video presentasi, dan memaximalkan fitur keamanan nya untuk melindungi seluruh data
        </p>
      </div>

    </div>

    <!-- VIEW 2: SLIDES PRESENTATION MODE -->
    <div id="slidesView" class="hidden">
      <div class="glass-card rounded-3xl p-8 sm:p-12 min-h-[420px] flex flex-col justify-between relative overflow-hidden">
        
        <!-- Top Slide Header -->
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
          <span id="slideCategory" class="text-xs font-semibold uppercase tracking-wider text-blue-400">BAGIAN 1 DARI 3</span>
          <div class="flex items-center space-x-2">
            <button onclick="copyCurrentSlide()" class="text-xs px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 transition flex items-center gap-1.5">
              <i class="fa-regular fa-copy"></i> Salin Slide
            </button>
          </div>
        </div>

        <!-- Slide Body Text -->
        <div class="my-auto py-4">
          <h2 id="slideTitle" class="text-2xl sm:text-3xl font-extrabold text-white mb-6">
            Mengapa Saya Pilih iPhone
          </h2>
          <p id="slideContent" class="text-gray-200 text-lg sm:text-xl leading-relaxed">
            mengapa aku pilih iphone karna iphone memudahkan aku dalam belajar, karna ipad dan iphone lebih mudah buat meyalurkan data dari device 1 ke device 2, iphone itu bukan hanya sekedar buat gaya gayaan tetapi iphone itu buat kegiatan sehari hari lebih enak dibandingkan android karna ios iphone itu lebih mulus dari pada android, daniphone merupakan investasi dalam janga yang cukup panjang untuk mendukung produktivitas
          </p>
        </div>

        <!-- Bottom Controls -->
        <div class="flex items-center justify-between pt-6 border-t border-white/10 mt-6">
          <button id="btnPrevSlide" onclick="changeSlide(-1)" class="px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-medium text-sm transition flex items-center gap-2 disabled:opacity-30 disabled:cursor-not-allowed">
            <i class="fa-solid fa-chevron-left"></i> Sebelumnya
          </button>
          
          <div class="flex space-x-2" id="slideDots">
            <div class="w-2.5 h-2.5 rounded-full bg-blue-500"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
          </div>

          <button id="btnNextSlide" onclick="changeSlide(1)" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition flex items-center gap-2">
            Berikutnya <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>

      </div>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="border-t border-white/10 py-6 text-center text-xs text-gray-500">
    <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© 2026 Paparan Motivasi - Siap Di-publish ke GitHub Pages</p>
      <div class="flex items-center space-x-4">
        <span class="inline-flex items-center gap-1.5 text-gray-400">
          <i class="fa-brands fa-github"></i> Ready for GitHub Pages
        </span>
      </div>
    </div>
  </footer>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 pointer-events-none bg-blue-600 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2 border border-blue-400/30">
    <i class="fa-solid fa-circle-check"></i>
    <span id="toastMsg">Teks berhasil disalin!</span>
  </div>

  <script>
    // Data Slide
    const slidesData = [
      {
        num: "BAGIAN 1 DARI 3",
        title: "1. Mengapa Saya Pilih iPhone",
        content: "mengapa aku pilih iphone karna iphone memudahkan aku dalam belajar, karna ipad dan iphone lebih mudah buat meyalurkan data dari device 1 ke device 2, iphone itu bukan hanya sekedar buat gaya gayaan tetapi iphone itu buat kegiatan sehari hari lebih enak dibandingkan android karna ios iphone itu lebih mulus dari pada android, daniphone merupakan investasi dalam janga yang cukup panjang untuk mendukung produktivitas"
      },
      {
        num: "BAGIAN 2 DARI 3",
        title: "2. Kelebihan iPhone Dibandingkan Android",
        content: "kelebihan iphone dibandingkan android sebenernya banyak tapi kelebihan utama nya terletak pada ios nya iphone Sistem operasinya mengelola memori secara cerdas sehingga performa tetap kencang meski dipakai bertahun-tahun. Fitur ekosistem seperti airDrop membuat proses berbagi tugas dan file menjadi instan, Ditambah jaminan pembaruan iOS jangka panjang dan keamanan privasi yang ketat, iphone menawarkan kenyamanan harian yang lebih konsisten dibanding Android"
      },
      {
        num: "BAGIAN 3 DARI 3",
        title: "3. Hal Yang Dioptimalkan Saat Menggunakan iPhone",
        content: "hal yang dioptimalkan saat menggunakan iphone ajku akan mengoptimalkan mode fokus untuk menjaga konsentrasi saat belajar agar tidak ada notif yang masuk. Dan aku juga akan mengoptimalkan kualitas kamera nya yang sangat jernih dan smooth untuk membuat video presentasi, dan memaximalkan fitur keamanan nya untuk melindungi seluruh data"
      }
    ];

    let currentSlide = 0;

    // Switch view mode
    function switchView(mode) {
      const essayView = document.getElementById('essayView');
      const slidesView = document.getElementById('slidesView');
      const btnEssay = document.getElementById('btnViewEssay');
      const btnSlides = document.getElementById('btnViewSlides');

      if (mode === 'essay') {
        essayView.classList.remove('hidden');
        slidesView.classList.add('hidden');
        btnEssay.classList.add('tab-active');
        btnSlides.classList.remove('tab-active');
      } else {
        essayView.classList.add('hidden');
        slidesView.classList.remove('hidden');
        btnSlides.classList.add('tab-active');
        btnEssay.classList.remove('tab-active');
        updateSlideUI();
      }
    }

    // Slide Control
    function changeSlide(direction) {
      currentSlide += direction;
      if (currentSlide < 0) currentSlide = 0;
      if (currentSlide >= slidesData.length) currentSlide = slidesData.length - 1;
      updateSlideUI();
    }

    function updateSlideUI() {
      const data = slidesData[currentSlide];
      document.getElementById('slideCategory').innerText = data.num;
      document.getElementById('slideTitle').innerText = data.title;
      document.getElementById('slideContent').innerText = data.content;

      // Update buttons
      document.getElementById('btnPrevSlide').disabled = currentSlide === 0;
      document.getElementById('btnNextSlide').disabled = currentSlide === slidesData.length - 1;

      // Update dots
      const dotsContainer = document.getElementById('slideDots');
      dotsContainer.innerHTML = '';
      slidesData.forEach((_, idx) => {
        const dot = document.createElement('div');
        dot.className = `w-2.5 h-2.5 rounded-full transition-all duration-300 ${idx === currentSlide ? 'bg-blue-500 w-6' : 'bg-white/20'}`;
        dotsContainer.appendChild(dot);
      });
    }

    // Copying Utilities
    function copyCardText(elementId) {
      const text = document.getElementById(elementId).innerText;
      copyToClipboard(text);
    }

    function copyCurrentSlide() {
      const text = `${slidesData[currentSlide].title}\n\n${slidesData[currentSlide].content}`;
      copyToClipboard(text);
    }

    function copyToClipboard(text) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      document.body.appendChild(textArea);
      textArea.select();
      try {
        document.execCommand('copy');
        showToast('Teks berhasil disalin!');
      } catch (err) {
        showToast('Gagal menyalin teks');
      }
      document.body.removeChild(textArea);
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = message;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 2500);
    }

    // Speech API
    let synth = window.speechSynthesis;
    let isSpeaking = false;

    function speakText(elementId, btn) {
      if (!synth) {
        showToast('Fitur suara tidak didukung browser ini.');
        return;
      }

      if (synth.speaking) {
        synth.cancel();
        if (isSpeaking) {
          isSpeaking = false;
          btn.innerHTML = '<i class="fa-solid fa-volume-high text-xs"></i>';
          return;
        }
      }

      const text = document.getElementById(elementId).innerText;
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'id-ID';
      utterance.rate = 0.95;

      utterance.onstart = () => {
        isSpeaking = true;
        btn.innerHTML = '<i class="fa-solid fa-square text-xs text-red-400"></i>';
      };

      utterance.onend = () => {
        isSpeaking = false;
        btn.innerHTML = '<i class="fa-solid fa-volume-high text-xs"></i>';
      };

      synth.speak(utterance);
    }
  </script>
</body>
</html>
